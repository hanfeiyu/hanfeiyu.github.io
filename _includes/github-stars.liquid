<img
  class="github-star-badge"
  src="https://img.shields.io/github/stars/{{ include.repository }}?style=social&amp;label=Stars"
  alt="{{ include.name | default: include.repository | escape }} GitHub stars"
  title="Live GitHub star count; the badge provider may briefly cache updates"
  height="20"
  loading="lazy"
  referrerpolicy="no-referrer"
>
