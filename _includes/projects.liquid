<div class="col">
  <div class="card h-100 hoverable">
    <a class="project-card-link" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
      {% if project.img and project.img_label %}
        <div class="project-brand">
          <img src="{{ project.img | relative_url }}" alt="" width="64" height="64" loading="eager">
          <span>{{ project.img_label | escape }}</span>
        </div>
      {% elsif project.img %}
        {% assign project_image_alt = project.img_alt | default: project.title %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "(min-width: 576px) 400px, 100vw"
          alt=project_image_alt
          class="card-img-top"
        %}
      {% elsif project.icon %}
        <div class="project-card-icon" aria-hidden="true"><i class="{{ project.icon }}"></i></div>
      {% endif %}
      <div class="card-body">
        <div class="project-heading">
          <h3 class="card-title">{{ project.title }}</h3>
          {% if project.github_stars %}
            {% include github-stars.liquid repository=project.github_stars name=project.title %}
          {% endif %}
        </div>
        <p class="card-text">{{ project.description }}</p>
      </div>
    </a>
    {% if project.github or project.links %}
      <div class="project-card-links">
        {% if project.github %}
          <div class="github-icon">
            <div class="icon" data-toggle="tooltip" title="Code Repository">
              <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
            </div>
          </div>
        {% endif %}
        {% for link in project.links %}
          <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.name }}</a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
